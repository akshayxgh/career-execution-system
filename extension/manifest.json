{
  "manifest_version": 3,
  "name": "Job Autofill Pro",
  "version": "2.0.1",
  "description": "Unified Career Assistant: Fill job applications across ATS portals (Workday, Greenhouse, Lever, Google, IBM) and run daily LinkedIn & Naukri growth routines.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "core/questionnaire.js",
        "core/field-detector.js",
        "core/field-matcher.js",
        "core/form-filler.js",
        "adapters/base-adapter.js",
        "adapters/linkedin-adapter.js",
        "adapters/naukri-adapter.js",
        "adapters/generic-adapter.js",
        "adapters/ibm-adapter.js",
        "adapters/workday-adapter.js",
        "adapters/successfactors-adapter.js",
        "adapters/greenhouse-adapter.js",
        "adapters/lever-adapter.js",
        "adapters/google-adapter.js",
        "adapters/shine-adapter.js",
        "core/site-detector.js",
        "content/content.js"
      ]
    }
  ]
}
