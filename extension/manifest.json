{
  "manifest_version": 3,
  "name": "Job Autofill Pro",
  "version": "1.2",
  "description": "Automatically fill job application forms across known ATS portals (PwC, IBM, Workday, SuccessFactors, Greenhouse, Lever, Google) and generic career sites.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "core/questionnaire.js",
        "core/field-detector.js",
        "core/field-matcher.js",
        "core/form-filler.js",
        "adapters/base-adapter.js",
        "adapters/generic-adapter.js",
        "adapters/ibm-adapter.js",
        "adapters/workday-adapter.js",
        "adapters/successfactors-adapter.js",
        "adapters/greenhouse-adapter.js",
        "adapters/lever-adapter.js",
        "adapters/google-adapter.js",
        "core/site-detector.js",
        "content/content.js"
      ]
    }
  ]
}
